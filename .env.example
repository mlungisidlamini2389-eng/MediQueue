# Copy the VITE_ variables to frontend/.env.local for the frontend.
VITE_API_URL=http://localhost:8000
VITE_GOOGLE_CLIENT_ID=

# Future backend configuration. Never expose these with a VITE_ prefix.
DATABASE_URL=postgresql://mediqueue:change_me@localhost:5432/mediqueue
GOOGLE_CLIENT_ID=

# Backend appointment notifications. Set these in the backend process environment.
# Never put provider credentials in VITE_ variables.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=

# Local AI summaries. Configure the backend environment; no API key is required.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=60
